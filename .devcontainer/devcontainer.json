{
  // Тег намеренно плавающий: воркспейсы одноразовые, и пересоздание должно
  // сразу давать свежий образ (еженедельная пересборка в CI). Воспроизводимость
  // при этом не теряется — окружение задаёт flake.lock, а образ лишь ускоряет
  // старт: home-manager switch досыпет разницу, если store-пути разойдутся.
  // Откат на конкретную сборку — иммутабельным тегом <профиль>-<дата>-<sha7>,
  // список: docker buildx imagetools inspect ghcr.io/cosmdandy/devcontainer:devops
  "name": "Dotfiles DevContainer",
  "image": "ghcr.io/cosmdandy/devcontainer:devops",
  // docker сам НЕ перетягивает уже имеющийся локальный тег — без этого хоста
  // (сервер/OrbStack) навсегда залипали на первом скачанном образе (ловили
  // образ 5-дневной давности). initializeCommand бежит на хосте до создания
  // контейнера: дайджест не изменился — no-op за секунды; офлайн — едем на
  // локальном (|| true).
  "initializeCommand": "docker pull ghcr.io/cosmdandy/devcontainer:devops || true",
  "onCreateCommand": "bash .devcontainer/setup.sh",
  // Обязательно, хотя в Dockerfile уже есть `USER cosmdandy`: образ несёт label
  // devcontainer.metadata с унаследованным от базового образа Microsoft
  // {"remoteUser":"vscode"}, и directive USER его НЕ перебивает — devcontainers
  // читает label. Без этой строки контейнер поднимется под vscode (проверено).
  "remoteUser": "cosmdandy",
  // Без этого devpod «чинит» расхождение uid контейнера (1000) с uid
  // пользователя docker-хоста и делает это самым дорогим способом:
  // chown -R по всему /home/cosmdandy. Там 1.5 ГБ и 54847 файлов (95% —
  // ~/.local/share/nvim: mason, lazy, парсеры treesitter), а overlay2 на
  // хосте собран с metacopy=false, поэтому смена владельца копирует каждый
  // файл из нижнего слоя в верхний. Замерено на kvt-d-01 (cluster=1001):
  // 8 минут 32 секунды из 8м52с всего devpod up, плюс ~1.3 ГБ в writable-слое
  // каждого контейнера.
  //
  // Хуже того, результат ещё и НЕРАБОЧИЙ: chown идёт только по домашнему
  // каталогу, а /nix остаётся за uid 1000, и home-manager switch падает с
  // «opening lock file /nix/var/nix/db/big-lock: Permission denied».
  //
  // Флаг возвращает нас к тому, как ведут себя рабочие репозитории: они
  // приезжают через --devcontainer-image без своего devcontainer.json,
  // remap там не срабатывает вовсе, и их воркспейсы годами живут на uid 1000
  // (каталоги на хосте devpod создаёт под тем же uid, что и пользователь
  // контейнера, — проверено: у kvt-* content-каталоги под 1000).
  "updateRemoteUserUID": false,
  // containerEnv против remoteEnv: первый задаёт переменные всему контейнеру,
  // второй — только процессам, которые запускает инструмент. Локаль и таймзона
  // нужны и фоновым демонам, и `docker exec`, поэтому им место в containerEnv
  // (дублируют ENV пребилт-образа, но делают конфиг самодостаточным на голом).
  // TERM/COLORTERM — свойство конкретной терминальной сессии, их место здесь.
  "containerEnv": {
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "TZ": "Europe/Moscow"
  },
  "remoteEnv": {
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/usr/bin/zsh" }
        }
      }
    }
  }
}
