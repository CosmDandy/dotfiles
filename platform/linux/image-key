#!/usr/bin/env bash
# Hash committed build inputs, including modes, filenames and the private gitlink.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
specs=()
while IFS= read -r pattern; do
  case $pattern in
    '!'*) specs+=(":(top,glob,exclude)${pattern#!}");;
    *) specs+=(":(top,glob)$pattern");;
  esac
done < platform/linux/image-inputs
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export GIT_INDEX_FILE="$tmp/index"
git read-tree "${1:-HEAD}"
git ls-files --stage -z -- "${specs[@]}" | sha256sum | cut -c1-24
