{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "orange", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {"base": "$text.base", "$disabled": "$text.muted", "$focused": "$hue.neutral.900", "$selected": "$hue.blue.200"},
        "secondary": {"base": "$text.muted", "$hovered": "$text.base"},
        "destructive": {"base": "$hue.neutral.900", "$disabled": "$text.muted"}
      },
      "formfield": {"base": "$text.base", "$hovered": "$text.base", "$focused": "$text.base", "$pressed": "$text.base", "$disabled": "$text.muted", "$selected": "$hue.blue.200"},
      "feedback": {
        "error": {"base": "$hue.red.200"},
        "warning": {"base": "$hue.yellow.200"},
        "success": {"base": "$hue.green.200"},
        "info": {"base": "$hue.cyan.200"}
      }
    },
    "background": {
      "base": "transparent",
      "raised": {"base": "$hue.neutral.700", "high": "$hue.neutral.600", "max": "$hue.neutral.500"},
      "action": {
        "primary": {"base": "transparent", "$hovered": "$background.raised.high", "$focused": "$hue.blue.200", "$selected": "transparent"},
        "secondary": {"base": "transparent"},
        "destructive": {"base": "$hue.red.200"}
      },
      "formfield": {"base": "$background.raised.high"},
      "feedback": {
        "error": {"base": "$background.raised.base"},
        "warning": {"base": "$background.raised.base"},
        "success": {"base": "$background.raised.base"},
        "info": {"base": "$background.raised.base"}
      }
    },
    "border": {"base": "$hue.neutral.400"},
    "scrollbar": {"base": "$hue.neutral.400"},
    "diff": {
      "text": {"added": "$hue.green.200", "removed": "$hue.red.200", "context": "$text.base", "hunkHeader": "$hue.cyan.200"},
      "background": {"added": "$hue.green.800", "removed": "$hue.red.800", "context": "transparent"},
      "highlight": {"added": "$hue.green.200", "removed": "$hue.red.200"},
      "lineNumber": {"text": "$text.muted", "background": {"added": "$hue.green.800", "removed": "$hue.red.800"}}
    },
    "syntax": {
      "comment": "$hue.neutral.400", "keyword": "$hue.green.200", "function": "$hue.blue.200",
      "variable": "$hue.neutral.200", "string": "$hue.cyan.200", "number": "$hue.purple.200",
      "type": "$hue.yellow.200", "operator": "$hue.green.200", "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200", "heading": "$hue.blue.200", "link": "$hue.blue.200", "linkText": "$hue.cyan.200",
      "code": "$hue.cyan.200", "blockQuote": "$hue.neutral.400", "emphasis": "$hue.yellow.200", "strong": "$hue.neutral.200",
      "horizontalRule": "$hue.neutral.400", "listItem": "$hue.blue.200", "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.200", "imageText": "$hue.cyan.200", "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {"background": {"base": "$background.raised.base", "action": {"primary": {"$hovered": "$background.raised.max"}}}}
  },
  "light": {
    "hue": {
      "gray": {"100": "#586e75", "200": "#657b83", "300": "#839496", "400": "#93a1a1", "500": "#d6d1bf", "600": "#eee8d5", "700": "#eee8d5", "800": "#fdf6e3", "900": "#fdf6e3"},
      "red": {"100": "#a82523", "200": "#dc322f", "300": "#df4b42", "400": "#e36658", "500": "#e88774", "600": "#edaa93", "700": "#f2c6ae", "800": "#e8c0c0", "900": "#fdf6e3"},
      "orange": {"100": "#9e3a12", "200": "#cb4b16", "300": "#d36836", "400": "#da8355", "500": "#e29f77", "600": "#e9b998", "700": "#f0d1b7", "800": "#f5dfc8", "900": "#fdf6e3"},
      "yellow": {"100": "#896700", "200": "#b58900", "300": "#bf9a25", "400": "#c9ab49", "500": "#d3bc6f", "600": "#ddcd96", "700": "#e7deba", "800": "#f1e8ce", "900": "#fdf6e3"},
      "green": {"100": "#657300", "200": "#859900", "300": "#97a824", "400": "#a9b749", "500": "#bbc66f", "600": "#cdd597", "700": "#dfe4bd", "800": "#c7e6c7", "900": "#fdf6e3"},
      "cyan": {"100": "#207973", "200": "#2aa198", "300": "#49afa5", "400": "#69bdb2", "500": "#8acbbf", "600": "#abd9cc", "700": "#cce7d9", "800": "#e0efdd", "900": "#fdf6e3"},
      "blue": {"100": "#1d6c9e", "200": "#268bd2", "300": "#479bd4", "400": "#68abd6", "500": "#8abbd8", "600": "#accbda", "700": "#cedbdc", "800": "#d8e8ed", "900": "#fdf6e3"},
      "purple": {"100": "#515397", "200": "#6c71c4", "300": "#8184c8", "400": "#9798cc", "500": "#adadd0", "600": "#c3c1d4", "700": "#d9d6d9", "800": "#eae6dc", "900": "#fdf6e3"},
      "accent": "$hue.blue", "interactive": "$hue.blue", "neutral": "$hue.gray"
    }
  },
  "dark": {
    "hue": {
      "gray": {"100": "#93a1a1", "200": "#839496", "300": "#657b83", "400": "#586e75", "500": "#164754", "600": "#073642", "700": "#073642", "800": "#002b36", "900": "#002b36"},
      "red": {"100": "#e87770", "200": "#dc322f", "300": "#bd302e", "400": "#9e2e2c", "500": "#7f2c2a", "600": "#602b29", "700": "#412a28", "800": "#4a1f1f", "900": "#002b36"},
      "orange": {"100": "#df8558", "200": "#cb4b16", "300": "#ae471b", "400": "#914320", "500": "#743f25", "600": "#573b2a", "700": "#3a372f", "800": "#1d3132", "900": "#002b36"},
      "yellow": {"100": "#cfad4d", "200": "#b58900", "300": "#9b7c08", "400": "#816f10", "500": "#676218", "600": "#4d5520", "700": "#334828", "800": "#193b30", "900": "#002b36"},
      "green": {"100": "#aaba4d", "200": "#859900", "300": "#728908", "400": "#5f7910", "500": "#4c6918", "600": "#395920", "700": "#264928", "800": "#0f3a28", "900": "#002b36"},
      "cyan": {"100": "#6abeb6", "200": "#2aa198", "300": "#249087", "400": "#1e7f76", "500": "#186e65", "600": "#125d54", "700": "#0c4c43", "800": "#063b38", "900": "#002b36"},
      "blue": {"100": "#67aee0", "200": "#268bd2", "300": "#217dc0", "400": "#1b6fae", "500": "#16619c", "600": "#10538a", "700": "#0b4578", "800": "#123e52", "900": "#002b36"},
      "purple": {"100": "#989bd6", "200": "#6c71c4", "300": "#5d67b0", "400": "#4e5d9c", "500": "#3f5388", "600": "#304974", "700": "#213f60", "800": "#12354c", "900": "#002b36"},
      "accent": "$hue.blue", "interactive": "$hue.blue", "neutral": "$hue.gray"
    }
  }
}
