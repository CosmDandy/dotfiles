@@ -0,0 +1,129 @@
+import { getGraphemeSegmenter, isImageLine, stripTerminalSequences, visibleWidth } from "@earendil-works/pi-tui";
+
+export interface VimPoint {
+	row: number;
+	index: number;
+}
+
+type WordMotion = "w" | "b" | "e";
+
+interface TextRow {
+	graphemes: string[];
+	columns: number[];
+}
+
+function compare(a: VimPoint, b: VimPoint): number {
+	return a.row - b.row || a.index - b.index;
+}
+
+export class VimText {
+	readonly lines: readonly string[];
+	readonly first: number;
+	private readonly rows = new Map<number, TextRow>();
+
+	constructor(lines: readonly string[], first: number) {
+		this.lines = lines;
+		this.first = first;
+	}
+
+	private row(row: number): TextRow {
+		const cached = this.rows.get(row);
+		if (cached) return cached;
+		const raw = this.lines[row] ?? "";
+		const plain = isImageLine(raw) ? "" : stripTerminalSequences(raw).trimEnd();
+		const graphemes = Array.from(getGraphemeSegmenter().segment(plain), ({ segment }) => segment);
+		const columns = [0];
+		for (const grapheme of graphemes) columns.push(columns.at(-1)! + visibleWidth(grapheme));
+		const result = { graphemes, columns };
+		this.rows.set(row, result);
+		return result;
+	}
+
+	clamp(point: VimPoint): VimPoint {
+		const row = Math.max(this.first, Math.min(point.row, this.lines.length - 1));
+		return { row, index: Math.max(0, Math.min(point.index, this.row(row).graphemes.length - 1)) };
+	}
+
+	firstNonblank(row: number): VimPoint {
+		const index = this.row(row).graphemes.findIndex((char) => /\S/u.test(char));
+		return { row, index: Math.max(index, 0) };
+	}
+
+	columns(point: VimPoint): [number, number] {
+		const { columns } = this.row(point.row);
+		const start = columns[point.index] ?? 0;
+		return [start, Math.max(start + 1, columns[point.index + 1] ?? start)];
+	}
+
+	vertical(point: VimPoint, delta: number, column: number): VimPoint {
+		const row = this.clamp({ row: point.row + delta, index: 0 }).row;
+		const { columns } = this.row(row);
+		const index = Math.max(0, columns.findLastIndex((col) => col <= column));
+		return this.clamp({ row, index });
+	}
+
+	private step(point: VimPoint, direction: 1 | -1): VimPoint | undefined {
+		const max = Math.max(0, this.row(point.row).graphemes.length - 1);
+		const index = point.index + direction;
+		if (index >= 0 && index <= max) return { row: point.row, index };
+		const row = point.row + direction;
+		if (row < this.first || row >= this.lines.length) return undefined;
+		return this.clamp({ row, index: direction === 1 ? 0 : Infinity });
+	}
+
+	private kind(point: VimPoint, big: boolean): number {
+		const char = this.row(point.row).graphemes[point.index] ?? " ";
+		return /\s/u.test(char) ? 0 : big || /[\p{L}\p{N}\p{M}_]/u.test(char) ? 1 : 2;
+	}
+
+	private wordOnce(point: VimPoint, motion: WordMotion, big: boolean): VimPoint {
+		const direction = motion === "b" ? -1 : 1;
+		let next = this.step(point, direction);
+		if (motion === "w") {
+			const kind = this.kind(point, big);
+			while (kind && next && next.row === point.row && this.kind(next, big) === kind) next = this.step(next, 1);
+		}
+		while (next && !this.kind(next, big)) next = this.step(next, direction);
+		if (!next) return motion === "b" ? { row: this.first, index: 0 } : this.clamp({ row: Infinity, index: Infinity });
+		if (motion === "w") return next;
+		const row = next.row;
+		const kind = this.kind(next, big);
+		let end = next;
+		while ((next = this.step(end, direction)) && next.row === row && this.kind(next, big) === kind) end = next;
+		return end;
+	}
+
+	word(point: VimPoint, motion: WordMotion, big: boolean, count: number): VimPoint {
+		for (let step = 0; step < count; step++) {
+			const next = this.wordOnce(point, motion, big);
+			if (compare(next, point) === 0) break;
+			point = next;
+		}
+		return point;
+	}
+
+	private selection(row: number, a: VimPoint, b: VimPoint, linewise: boolean): [number, number] | undefined {
+		const [start, end] = compare(a, b) <= 0 ? [a, b] : [b, a];
+		if (row < start.row || row > end.row) return undefined;
+		const from = !linewise && row === start.row ? start.index : 0;
+		const to = !linewise && row === end.row ? end.index + 1 : this.row(row).graphemes.length;
+		return [from, to];
+	}
+
+	selectionColumns(row: number, anchor: VimPoint, point: VimPoint, linewise: boolean): [number, number] | undefined {
+		const span = this.selection(row, anchor, point, linewise);
+		if (!span) return undefined;
+		const { columns } = this.row(row);
+		return [columns[span[0]] ?? 0, columns[span[1]] ?? columns.at(-1)!];
+	}
+
+	text(anchor: VimPoint, point: VimPoint, linewise: boolean): string {
+		const from = Math.min(anchor.row, point.row), to = Math.max(anchor.row, point.row);
+		const lines: string[] = [];
+		for (let row = from; row <= to; row++) {
+			const span = this.selection(row, anchor, point, linewise)!;
+			lines.push(this.row(row).graphemes.slice(...span).join(""));
+		}
+		return lines.join("\n") + (linewise ? "\n" : "");
+	}
+}
