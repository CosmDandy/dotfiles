new file mode 100644
index 0000000..8dc1828
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/vim-dock.ts
@@ -0,0 +1,131 @@
+import {
+	backgroundAnsi,
+	type Color,
+	colorToRgb,
+	type Component,
+	compositeTuiLine,
+	foregroundAnsi,
+	getTerminalColorMode,
+	indexedColor,
+	isImageLine,
+	type LayoutFrame,
+	mixColors,
+	rgbColor,
+	stripTerminalSequences,
+	visibleWidth,
+} from "@earendil-works/pi-tui";
+import { theme } from "./theme/theme.ts";
+
+function grayscale(color: Color): Color {
+	const { r, g, b } = colorToRgb(color);
+	const gray = Math.round(0.2126 * r + 0.7152 * g + 0.0722 * b);
+	return rgbColor(gray, gray, gray);
+}
+
+const faders = new Map<boolean, { colors: typeof theme.colors; mode: ReturnType<typeof getTerminalColorMode>; paint: (line: string) => string }>();
+
+function frameFader(dock: boolean): (line: string) => string {
+	const mode = getTerminalColorMode();
+	const colors = theme.colors;
+	const previous = faders.get(dock);
+	if (previous?.colors === colors && previous.mode === mode) return previous.paint;
+	const canvas = dock ? colors.userMessageBg : grayscale(colors.userMessageBg);
+	const text = dock ? colors.text : grayscale(colors.text);
+	const foreground = mixColors(canvas, text, dock ? 0.38 : 0.88, "srgb");
+	const fade = (color: Color, background: boolean) => {
+		const gray = grayscale(color);
+		const muted = dock ? mixColors(gray, color, 0.25, "srgb") : gray;
+		return background ? mixColors(canvas, muted, dock ? 0.22 : 0.45, "srgb")
+			: mixColors(foreground, muted, dock ? 0.07 : 0.12, "srgb");
+	};
+	const defaultFg = foregroundAnsi(foreground, mode);
+	const sgr = /\x1b\[([0-9;]*)m/g;
+	const emit = (color: Color, background: boolean) =>
+		(background ? backgroundAnsi : foregroundAnsi)(fade(color, background), mode);
+	const cache = new Map<string, string>();
+	const recolor = (line: string) => defaultFg + line.replace(sgr, (_match, parameters: string) => {
+		const cached = cache.get(parameters);
+		if (cached !== undefined) return cached;
+		const values = parameters.split(";").map(Number);
+		let painted = "";
+		for (let index = 0; index < values.length; index++) {
+			const code = values[index]!;
+			if (code === 0 || code === 39) painted += (code === 0 ? "\x1b[0m" : "") + defaultFg;
+			else if (dock && (code === 1 || code === 2)) continue;
+			else if (code >= 30 && code <= 37) painted += emit(indexedColor(code - 30), false);
+			else if (code >= 40 && code <= 47) painted += emit(indexedColor(code - 40), true);
+			else if (code >= 90 && code <= 97) painted += emit(indexedColor(code - 82), false);
+			else if (code >= 100 && code <= 107) painted += emit(indexedColor(code - 92), true);
+			else if ((code === 38 || code === 48) && values[index + 1] === 5 && index + 2 < values.length) {
+				painted += emit(indexedColor(values[index + 2]!), code === 48);
+				index += 2;
+			} else if ((code === 38 || code === 48) && values[index + 1] === 2 && index + 4 < values.length) {
+				painted += emit(rgbColor(values[index + 2]!, values[index + 3]!, values[index + 4]!), code === 48);
+				index += 4;
+			} else painted += `\x1b[${code}m`;
+		}
+		if (cache.size >= 512) cache.clear();
+		cache.set(parameters, painted);
+		return painted;
+	});
+	const lines = new Map<string, string>();
+	const paint = (line: string) => {
+		const cached = lines.get(line);
+		if (cached !== undefined) return cached;
+		const painted = recolor(line);
+		if (lines.size >= 512) lines.clear();
+		lines.set(line, painted);
+		return painted;
+	};
+	faders.set(dock, { colors, mode, paint });
+	return paint;
+}
+
+function fadeRows(
+	screen: string[], start: number, height: number, fade: (line: string) => string, keep?: readonly [number, number],
+): void {
+	for (let row = start; row < start + height; row++) {
+		if (keep && row >= keep[0] && row < keep[1]) continue;
+		const line = screen[row] ?? "";
+		if (!isImageLine(line)) screen[row] = fade(line);
+	}
+}
+
+export interface TranscriptPaintRegion {
+	top: number;
+	bottom: number;
+	offset: number;
+}
+
+export function paintVimFrame(
+	screen: string[], frame: LayoutFrame, editor: Component, mode: "NORMAL" | "VISUAL",
+	openRows?: readonly [number, number],
+): TranscriptPaintRegion | undefined {
+	const transcript = frame.primaryScrollView && frame.root.children.find((box) => box.scrollView === frame.primaryScrollView);
+	let region: TranscriptPaintRegion | undefined;
+	if (transcript?.scrollView) {
+		const { y, height } = transcript.clip;
+		const offset = transcript.rect.y - transcript.scrollView.scrollTop;
+		const keep = openRows && [openRows[0] + offset, openRows[1] + offset] as const;
+		fadeRows(screen, y, height, frameFader(false), keep);
+		region = { top: y, bottom: y + height, offset };
+	}
+	const dock = frame.root.children.find((box) => box.children.some((child) => child.component === editor));
+	const input = dock?.children.find((child) => child.component === editor);
+	if (!dock || !input) return region;
+	fadeRows(screen, dock.clip.y, dock.clip.height, frameFader(true));
+	const label = theme.style(` ${mode} `, { fg: "accent", bg: "selectedBg", bold: true });
+	const labelWidth = visibleWidth(label);
+	// The custom editor has a status row; the stock editor just has a border. Never paint over status text.
+	for (let offset = 0; offset < Math.min(2, input.clip.height); offset++) {
+		const row = input.clip.y + offset;
+		const line = screen[row] ?? "";
+		const plain = stripTerminalSequences(line);
+		const slot = plain.match(new RegExp(`${offset === 0 ? "[ ─]" : "─"}{${labelWidth + 2},}`));
+		if (slot?.index === undefined) continue;
+		const column = visibleWidth(plain.slice(0, slot.index)) + 1;
+		screen[row] = compositeTuiLine(line, label, column, labelWidth, frame.width);
+		break;
+	}
+	return region;
+}
