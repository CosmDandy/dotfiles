@@ -0,0 +1,398 @@
+import { stripVTControlCharacters } from "node:util";
+import {
+	compositeTuiLine,
+	Container,
+	extractAnsiCode,
+	isImageLine,
+	matchesKey,
+	mixColors,
+	parseKey,
+	rgbColor,
+	type ScrollView,
+	sliceByColumn,
+	visibleWidth,
+} from "@earendil-works/pi-tui";
+import { copyToClipboard } from "../../utils/clipboard.ts";
+import { AssistantMessageComponent } from "./components/assistant-message.ts";
+import { BashExecutionComponent } from "./components/bash-execution.ts";
+import { ToolExecutionComponent } from "./components/tool-execution.ts";
+import { theme } from "./theme/theme.ts";
+import type { TranscriptPaintRegion } from "./vim-dock.ts";
+import { type VimPoint, VimText } from "./vim-text.ts";
+
+type ToolBlock = ToolExecutionComponent | BashExecutionComponent;
+type Block = ToolBlock | AssistantMessageComponent;
+interface Position {
+	block: Block;
+	row: number;
+	lines: readonly string[];
+	first: number;
+}
+interface Detail {
+	block: Block;
+	wasExpanded?: boolean;
+	text?: VimText;
+	point?: VimPoint;
+	anchor?: VimPoint;
+	linewise: boolean;
+	preferredColumn?: number;
+}
+
+function isTool(child: unknown): child is ToolBlock {
+	return (child instanceof ToolExecutionComponent && !child.isHidden) || child instanceof BashExecutionComponent;
+}
+
+function firstContentRow(lines: readonly string[]): number {
+	return Math.max(0, lines.findIndex((line) => !isImageLine(line) && stripVTControlCharacters(line).trim().length > 0));
+}
+
+function between(value: number, a: number, b: number): boolean {
+	return value >= Math.min(a, b) && value <= Math.max(a, b);
+}
+
+function tintLine(line: string, width: number, style: (text: string) => string): string {
+	let result = "";
+	let start = 0;
+	for (let index = 0; index < line.length;) {
+		const ansi = extractAnsiCode(line, index);
+		if (!ansi) { index++; continue; }
+		if (index > start) result += style(line.slice(start, index));
+		result += ansi.code;
+		index += ansi.length;
+		start = index;
+	}
+	const trailing = line.slice(start) + " ".repeat(Math.max(0, width - visibleWidth(line)));
+	return trailing ? result + style(trailing) : result;
+}
+
+function tintSpan(line: string, [start, end]: [number, number], width: number, style: (text: string) => string): string {
+	const size = Math.min(end, width) - start;
+	if (size <= 0) return line;
+	return compositeTuiLine(line, tintLine(sliceByColumn(line, start, size, true), size, style), start, size, width);
+}
+
+function firstBlockAtOrAfter(positions: Position[], row: number): number {
+	let lo = 0;
+	let hi = positions.length;
+	while (lo < hi) {
+		const mid = (lo + hi) >>> 1;
+		const item = positions[mid]!;
+		if (item.row + item.first < row) lo = mid + 1;
+		else hi = mid;
+	}
+	return lo;
+}
+
+export class VimTranscript extends Container {
+	focused = false;
+
+	get mode(): "NORMAL" | "VISUAL" | undefined {
+		if (!this.focused || !this.selected) return undefined;
+		return this.anchor !== undefined || this.detail?.anchor !== undefined ? "VISUAL" : "NORMAL";
+	}
+
+	private selected?: Block;
+	private anchor?: Block;
+	private detail?: Detail;
+	private count = "";
+	private revealPending = false;
+	private followOnLeave = false;
+	private notice = "";
+	private copied?: symbol;
+
+	private readonly viewport: () => ScrollView | undefined;
+	private positionCache?: {
+		layout: NonNullable<VimTranscript["childLines"]>;
+		offset: number;
+		positions: Position[];
+		indices: Map<Block, number>;
+	};
+	private readonly chatRow: () => number | undefined;
+	private readonly requestRender: () => void;
+	private readonly focusEditor: () => void;
+	private readonly onCopyError: (error: unknown) => void;
+
+	constructor(
+		viewport: () => ScrollView | undefined,
+		chatRow: () => number | undefined,
+		requestRender: () => void,
+		focusEditor: () => void,
+		onCopyError: (error: unknown) => void,
+	) {
+		super();
+		this.viewport = viewport;
+		this.chatRow = chatRow;
+		this.requestRender = requestRender;
+		this.focusEditor = focusEditor;
+		this.onCopyError = onCopyError;
+	}
+
+	enter(): boolean {
+		const selected = this.positions().at(-1)?.block ?? this.children.findLast(isTool);
+		const viewport = this.viewport();
+		if (!selected || !viewport) return false;
+		this.closeDetail();
+		this.selected = selected;
+		this.anchor = undefined;
+		this.count = this.notice = "";
+		this.followOnLeave = viewport.isFollowingEnd;
+		viewport.scrollTo(viewport.scrollTop, { disableFollow: true });
+		this.revealPending = true;
+		this.requestRender();
+		return true;
+	}
+
+	leave(): void {
+		this.closeDetail();
+		this.selected = this.anchor = this.copied = undefined;
+		this.revealPending = false;
+		if (this.followOnLeave) this.viewport()?.scrollToEnd();
+		this.focusEditor();
+		this.requestRender();
+	}
+
+	openRows(): readonly [number, number] | undefined {
+		const detail = this.detail;
+		const layout = this.childLines;
+		if (!detail || !layout) return undefined;
+		const item = this.positionOf(detail.block);
+		return item && [item.row, item.row + item.lines.length];
+	}
+
+	private positions(): Position[] {
+		const layout = this.childLines;
+		const offset = this.chatRow() ?? 0;
+		if (this.positionCache && this.positionCache.layout === layout && this.positionCache.offset === offset) {
+			return this.positionCache.positions;
+		}
+		const positions: Position[] = [];
+		const indices = new Map<Block, number>();
+		let row = offset;
+		if (layout) {
+			for (let index = 0; index < layout.children.length; index++) {
+				const child = layout.children[index]!;
+				const lines = layout.parts[index]!;
+				if (lines.length && (isTool(child) || child instanceof AssistantMessageComponent)) {
+					indices.set(child, positions.length);
+					positions.push({ block: child, row, lines, first: firstContentRow(lines) });
+				}
+				row += lines.length;
+			}
+			this.positionCache = { layout, offset, positions, indices };
+		} else this.positionCache = undefined;
+		return positions;
+	}
+
+	private positionIndex(block: Block | undefined): number {
+		return block ? this.positionCache?.indices.get(block) ?? -1 : -1;
+	}
+
+	private positionOf(block: Block | undefined): Position | undefined {
+		const positions = this.positions();
+		return positions[this.positionIndex(block)];
+	}
+
+	private closeDetail(): void {
+		const detail = this.detail;
+		if (!detail) return;
+		if (isTool(detail.block)) detail.block.setExpanded(detail.wasExpanded ?? false);
+		this.detail = undefined;
+	}
+
+	private prepareText(detail: Detail, item: Position): { text: VimText; point: VimPoint } {
+		if (!detail.text || detail.text.lines !== item.lines) detail.text = new VimText(item.lines, item.first);
+		const text = detail.text;
+		const point = detail.point = text.clamp(detail.point ?? text.firstNonblank(item.first));
+		if (detail.anchor) detail.anchor = text.clamp(detail.anchor);
+		return { text, point };
+	}
+
+	private reveal(): void {
+		const viewport = this.viewport();
+		const item = this.positionOf(this.selected);
+		if (!viewport || !item) return;
+		const absolute = item.row + (this.detail ? this.prepareText(this.detail, item).point.row : item.first);
+		const top = viewport.scrollTop;
+		if (absolute < top) viewport.scrollTo(absolute, { disableFollow: true });
+		else if (absolute >= top + viewport.viewportHeight) {
+			viewport.scrollTo(absolute - Math.max(0, viewport.viewportHeight - 1), { disableFollow: true });
+		}
+	}
+
+	private copy(lines: readonly string[]): void {
+		this.copyText(lines.filter((line) => !isImageLine(line)).map((line) => stripVTControlCharacters(line).trimEnd()).join("\n"));
+	}
+
+	private copyText(text: string): void {
+		if (!text) return;
+		const token = this.copied = Symbol();
+		void copyToClipboard(text).then(() => {
+			if (this.copied !== token) return;
+			this.notice = "✓";
+			this.requestRender();
+		}, (error) => {
+			if (this.copied !== token) return;
+			this.notice = "!";
+			this.onCopyError(error);
+			this.requestRender();
+		});
+	}
+
+	private scrollBlocks(viewport: ScrollView, positions: Position[], amount: number): void {
+		viewport.scrollTo(viewport.scrollTop + amount, { disableFollow: true });
+		const top = viewport.scrollTop;
+		const bottom = top + viewport.viewportHeight;
+		const first = firstBlockAtOrAfter(positions, top);
+		const end = firstBlockAtOrAfter(positions, bottom);
+		const index = this.positionIndex(this.selected);
+		if (first === end || (index >= first && index < end)) return;
+		this.selected = positions[amount < 0 ? end - 1 : first]!.block;
+	}
+
+	private jumpBlock(viewport: ScrollView, positions: Position[], index: number, delta: number): void {
+		const item = positions[index]!;
+		const top = viewport.scrollTop;
+		const bottom = top + viewport.viewportHeight;
+		let target = index + delta;
+		if (item.row + item.first < top || item.row + item.first >= bottom) {
+			// If paging left the cursor off-screen, the first step starts at the viewport, not at the old tool.
+			const start = delta < 0 ? firstBlockAtOrAfter(positions, bottom) - 1 : firstBlockAtOrAfter(positions, top);
+			target = start + delta - Math.sign(delta);
+		}
+		this.selected = positions[Math.max(0, Math.min(positions.length - 1, target))]!.block;
+		this.revealPending = true;
+	}
+
+	handleInput(data: string): void {
+		const key = (id: Parameters<typeof matchesKey>[1]) => matchesKey(data, id);
+		const viewport = this.viewport();
+		const positions = this.positions();
+		const index = this.positionIndex(this.selected);
+		if (!viewport || index === -1 || key("i") || key("q") || key("ctrl+c")) return this.leave();
+		this.notice = "";
+		this.copied = undefined;
+		const digit = parseKey(data);
+		if (digit && /^[0-9]$/.test(digit) && (digit !== "0" || this.count)) {
+			this.count = (this.count + digit).slice(0, 6);
+			this.requestRender();
+			return;
+		}
+		const count = Number(this.count) || 1;
+		this.count = "";
+		const down = key("down") || key("j");
+		const up = key("up") || key("k");
+		const half = key("ctrl+u") || key("ctrl+d");
+		const page = half || key("ctrl+b") || key("ctrl+f");
+		const delta = (down || up ? 1 : half ? Math.ceil(viewport.viewportHeight / 2) : viewport.viewportHeight)
+			* (up || key("ctrl+u") || key("ctrl+b") ? -count : count);
+		const item = positions[index]!;
+		const select = key("v") || key("shift+v");
+		if (this.detail) {
+			const detail = this.detail;
+			const { text, point } = this.prepareText(detail, item);
+			const word = key("w") || key("shift+w") ? "w" : key("b") || key("shift+b") ? "b" : key("e") || key("shift+e") ? "e" : undefined;
+			let next: VimPoint | undefined;
+			const vertical = up || down || page;
+			if (vertical) {
+				detail.preferredColumn ??= text.columns(point)[0];
+				next = text.vertical(point, delta, detail.preferredColumn);
+			} else if (word) next = text.word(point, word, key("shift+w") || key("shift+b") || key("shift+e"), count);
+			else if (key("h") || key("l")) next = { ...point, index: point.index + (key("h") ? -count : count) };
+			else if (key("0") || key("home")) next = { ...point, index: 0 };
+			else if (key("^")) next = text.firstNonblank(point.row);
+			else if (key("$") || key("end")) next = { row: point.row + count - 1, index: Infinity };
+			else if (key("ctrl+a")) next = text.firstNonblank(item.first);
+			else if (select) {
+				const linewise = key("shift+v");
+				detail.anchor = detail.anchor && detail.linewise === linewise ? undefined : detail.anchor ?? point;
+				detail.linewise = linewise;
+			} else if (key("y")) {
+				this.copyText(text.text(detail.anchor ?? point, point, !detail.anchor || detail.linewise));
+				detail.anchor = undefined;
+			} else if (key("escape") && detail.anchor) detail.anchor = undefined;
+			else if (key("escape") || key("return") || key("left")) {
+				this.closeDetail();
+				this.revealPending = true;
+			}
+			if (next) {
+				detail.point = text.clamp(next);
+				if (!vertical) detail.preferredColumn = undefined;
+				this.revealPending = true;
+			}
+		} else if (up || down) this.jumpBlock(viewport, positions, index, delta);
+		else if (page) this.scrollBlocks(viewport, positions, delta);
+		else if (key("ctrl+a")) this.scrollBlocks(viewport, positions, -viewport.scrollTop);
+		else if (key("escape")) this.anchor = undefined;
+		else if (select) this.anchor = this.anchor ? undefined : item.block;
+		else if (key("return") || key("right")) {
+			this.anchor = undefined;
+			this.detail = { block: item.block, linewise: false };
+			if (isTool(item.block)) {
+				this.detail.wasExpanded = item.block.isExpanded;
+				item.block.setExpanded(true);
+			}
+			this.revealPending = true;
+		} else if (key("y")) {
+			const anchor = this.anchor ? positions.findIndex(({ block }) => block === this.anchor) : index;
+			const start = anchor === -1 ? index : anchor;
+			this.copy(positions.slice(Math.min(start, index), Math.max(start, index) + 1).flatMap(({ lines, first }) => lines.slice(first)));
+			this.anchor = undefined;
+		}
+		this.requestRender();
+	}
+
+	override render(width: number): readonly string[] {
+		const selected = this.focused ? this.selected : undefined;
+		for (const tool of this.children.filter(isTool)) tool.setResultHidden(selected !== undefined && tool !== this.detail?.block);
+		const source = super.render(width);
+		if (selected && this.revealPending) {
+			this.revealPending = false;
+			queueMicrotask(() => { if (this.focused) this.reveal(); });
+		}
+		return source;
+	}
+
+	paintVisible(screen: string[], width: number, { top, bottom, offset }: TranscriptPaintRegion): void {
+		const positions = this.positions();
+		const index = this.positionIndex(this.selected);
+		if (index === -1 || width < 1) return;
+		const anchor = this.positionIndex(this.anchor);
+		const detail = this.detail;
+		const textView = detail ? this.prepareText(detail, positions[index]!) : undefined;
+		const detailAnchor = detail?.anchor;
+		const background = mixColors(theme.colors.selectedBg, rgbColor(42, 161, 152), theme.appearance === "dark" ? 0.3 : 0.2);
+		const highlight = (text: string) => theme.style(text, { bg: background });
+		const highlightSelection = (text: string) => theme.bg("selectedBg", text);
+		const start = textView ? index : firstBlockAtOrAfter(positions, top - offset);
+		const stop = textView ? index + 1 : firstBlockAtOrAfter(positions, bottom - offset);
+		for (let block = start; block < stop; block++) {
+			const item = positions[block]!;
+			const origin = offset + item.row;
+			const first = Math.max(item.first, top - origin);
+			const end = Math.min(textView ? item.lines.length : item.first + 1, bottom - origin);
+			for (let row = first; row < end; row++) {
+				const y = origin + row;
+				const line = screen[y] ?? "";
+				if (isImageLine(line)) continue;
+				const current = block === index && row === (textView?.point.row ?? item.first);
+				const span = textView && detailAnchor
+					? textView.text.selectionColumns(row, detailAnchor, textView.point, detail?.linewise ?? false) : undefined;
+				const selected = !!span || (!textView && anchor >= 0 && between(block, anchor, index));
+				const label = (current ? this.notice || this.count || (textView ? "│" : "▸")
+					: String(Math.abs(textView ? row - textView.point.row : block - index))).slice(0, width);
+				const caret = current && textView ? textView.text.columns(textView.point) : undefined;
+				const badgeWidth = visibleWidth(label);
+				const badge = theme.style(label, {
+					fg: current || selected ? "text" : "error",
+					bg: current ? background : selected ? theme.colors.selectedBg : theme.colors.userMessageBg,
+					bold: true,
+				});
+				let painted = current ? tintLine(line, width, highlight) : line;
+				if (span) painted = detail?.linewise ? tintLine(painted, width, highlightSelection) : tintSpan(painted, span, width, highlightSelection);
+				if (caret) painted = tintSpan(painted, caret, width, (text) => theme.inverse(text));
+				// Anchor annotations to the same edge even over tables and unpadded wrapped lines.
+				screen[y] = compositeTuiLine(painted, caret && caret[0] < badgeWidth ? theme.inverse(badge) : badge, 0, badgeWidth, width);
+			}
+		}
+	}
+}
