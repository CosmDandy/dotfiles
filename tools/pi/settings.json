{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "solarized-light/solarized-dark",
  "transport": "sse",
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.2-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode"],
  "doubleEscapeAction": "none",
  "showCacheMissNotices": true,
  "fullscreenExitOutput": "resume-hint",
  "treeFilterMode": "user-only",
  "markdown": { "mermaid": "final" },
  "compaction": {
    "modelOverrides": {
      "openai-codex/gpt-5.6-luna": { "reserveTokens": 95200 },
      "openai-codex/gpt-5.6-sol": { "reserveTokens": 95200 },
      "openai-codex/gpt-5.6-terra": { "reserveTokens": 95200 },
      "openai-codex/gpt-6-astra": { "reserveTokens": 95200 },
      "openai-codex/gpt-6-luna": { "reserveTokens": 95200 },
      "openai-codex/gpt-6-sol": { "reserveTokens": 95200 },
      "openai-codex/gpt-6.1-sol": { "reserveTokens": 175000 },
      "openai-codex/gpt-6.1-terra": { "reserveTokens": 175000 },
      "openai-codex/gpt-6.2-astra": { "reserveTokens": 95200 },
      "openai-codex/gpt-6.2-sol": { "reserveTokens": 200000 }
    }
  }
}
