{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "solarized-light/solarized-dark",
  "transport": "websocket-cached",
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.2-sol",
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
    "openai-codex/gpt-6.2-sol:xhigh",
    "openai-codex/sol-medium:medium",
    "openai-codex/gpt-6.2-astra:xhigh"
  ],
  "subagents": {
    "defaultModel": "openai-codex/sol-medium:medium",
    "defaultExtensions": ["~/.pi/agent/extensions/sol-medium.ts"],
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["openai-codex/gpt-6.2-sol", "openai-codex/sol-medium", "openai-codex/gpt-6.2-astra"]
    },
    "agentOverrides": {
      "scout": { "tools": ["read", "grep", "find", "ls", "bash"], "thinking": "medium", "inheritProjectContext": false },
      "reviewer": { "tools": ["read", "grep", "find", "ls", "bash"], "thinking": "medium", "inheritProjectContext": false },
      "oracle": { "tools": ["read", "grep", "find", "ls", "bash"], "thinking": "medium", "inheritProjectContext": false },
      "worker": { "disabled": true },
      "delegate": { "disabled": true },
      "researcher": { "disabled": true },
      "evidence-auditor": { "disabled": true },
      "claude-code": { "disabled": true },
      "claude-code-writer": { "disabled": true },
      "codex-exec": { "disabled": true },
      "codex-exec-writer": { "disabled": true },
      "cursor-agent": { "disabled": true },
      "cursor-agent-writer": { "disabled": true }
    }
  },
  "defaultTools": ["+codemode"],
  "doubleEscapeAction": "none",
  "showCacheMissNotices": true,
  "fullscreenExitOutput": "resume-hint",
  "treeFilterMode": "user-only",
  "markdown": { "mermaid": "final" },
  "compaction": {
    "modelOverrides": {
      "openai-codex/gpt-5.6-luna": { "reserveTokens": 95200 },
      "openai-codex/gpt-5.6-sol": { "reserveTokens": 95200 },
      "openai-codex/gpt-5.6-terra": { "reserveTokens": 95200 },
      "openai-codex/gpt-6-astra": { "reserveTokens": 95200 },
      "openai-codex/gpt-6-luna": { "reserveTokens": 95200 },
      "openai-codex/gpt-6-sol": { "reserveTokens": 95200 },
      "openai-codex/gpt-6.1-sol": { "reserveTokens": 175000 },
      "openai-codex/gpt-6.1-terra": { "reserveTokens": 175000 },
      "openai-codex/gpt-6.2-astra": { "reserveTokens": 95200 },
      "openai-codex/gpt-6.2-sol": { "reserveTokens": 200000 }
    }
  }
}
