#!/usr/bin/env zsh

typeset -g UPD_ROOT="${${${(%):-%N}:A:h}:h:h}"

_upd_detect_system() {
  case "$(uname -s)" in
    Darwin) print darwin ;;
    Linux) if [[ -e /etc/NIXOS ]]; then print nixos; else print linux; fi ;;
    *) print -u2 'Unsupported operating system'; return 1 ;;
  esac
}

_upd_step() {
  local label=$1; shift
  print -r -- "  $label: ${(q)@}"
  local -F start=$EPOCHREALTIME
  "$@"
  local code=$?
  printf '  %s: exit %d (%.1fs)\n' "$label" "$code" "$(( EPOCHREALTIME - start ))"
  if (( code )); then
    print -u2 'Stopped. Earlier steps remain applied; no automatic rollback was performed.'
  fi
  return $code
}

_upd_clt() {
  local available label
  available=$(softwareupdate --list) || return
  label=$(print -r -- "$available" | grep -o 'Command Line Tools for Xcode [0-9.]*-[0-9.]*' | tail -1)
  if [[ -n $label ]]; then sudo softwareupdate -i "$label"; fi
}

_upd_casks() {
  local out cask
  local -a outdated failed
  out=$(NO_COLOR=1 brew outdated --cask --greedy --quiet) || return
  outdated=(${(f)out})
  (( ${#outdated} )) || return 0
  sudo -v || return
  for cask in "${outdated[@]}"; do
    brew upgrade --cask --greedy "$cask" || failed+=("$cask")
  done
  if (( ${#failed} )); then
    print -u2 -r -- "Failed casks: ${failed[*]}"
    return 1
  fi
}

_upd_uv_tool() {
  local name=$1
  if [[ -x "${UV_TOOL_BIN_DIR:-$HOME/.local/bin}/$name" ]]; then
    uv tool upgrade "$name"
  else
    uv tool install --force "$name"
  fi
}

_upd_mcp() {
  local -i code=0
  if (( $+commands[npm] )); then
    npm i -g --prefix "${NPM_CONFIG_PREFIX:-$HOME/.npm-global}" @upstash/context7-mcp@latest || code=1
  fi
  if (( $+commands[uv] )); then
    _upd_uv_tool mcp-atlassian || code=1
    if [[ $_upd_system == darwin ]]; then
      _upd_uv_tool things-mcp || code=1
      local dir="$UPD_ROOT/tools/claude/custom/mcp/timing"
      local plist="$HOME/Library/LaunchAgents/com.cosmdandy.timing-mcp.plist"
      if [[ -f "$dir/pyproject.toml" ]]; then
        if uv lock --upgrade --directory "$dir" --quiet && uv sync --locked --directory "$dir" --quiet; then
          if [[ -e $plist ]]; then
            launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null
            launchctl bootstrap "gui/$(id -u)" "$plist" || code=1
          fi
        else
          code=1
        fi
      fi
    fi
  fi
  return $code
}

_upd_nvim() {
  [[ -f "$HOME/.config/nvim/init.lua" ]] || return 0
  local log="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/mason.log" failed
  local -i offset=0
  [[ -f $log ]] && offset=$(wc -c < "$log")
  nvim --headless '+Lazy! update' +qa || return
  nvim --headless "+lua local h = require('nvim-treesitter').update(); if h then h:wait(600000) end" \
    '+MasonToolsUpdateSync' +qa || return
  # Mason reports installation errors in its log but still exits Neovim with zero.
  if [[ -f $log ]]; then
    failed=$(tail -c "+$(( offset + 1 ))" "$log" | grep -o 'Installation failed for Package(name=[^)]*)' | sort -u) || true
    if [[ -n $failed ]]; then
      print -u2 -r -- "$failed"
      return 1
    fi
  fi
}

_upd_zinit() {
  local ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
  [[ -f "$ZINIT_HOME/zinit.zsh" ]] || return 0
  source "$ZINIT_HOME/zinit.zsh" || return
  zinit self-update && zinit update && zinit cclear
}

_upd_main() {
  emulate -L zsh
  setopt pipefail
  zmodload zsh/datetime
  local _upd_mode=${1-}
  if (( $# > 1 )) || { (( $# == 1 )) && [[ $_upd_mode != (install|--help|-h) ]]; }; then
    print -u2 'Usage: upd [install]'
    return 2
  fi
  if [[ $_upd_mode == (--help|-h) ]]; then
    print 'Usage: upd [install]
  upd          Update dependencies, apply configuration, and update apps and tools.
  upd install  Apply local configuration using the existing lock; no upgrades.
No Git pull/reset, app cleanup, or generation pruning is performed.'
    return 0
  fi
  local _upd_system
  _upd_system=$(_upd_detect_system) || return
  local flake="$UPD_ROOT/platform/nix" target profile arch
  export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1
  case $_upd_system in
    darwin) target="$flake#macbook-cosmdandy" ;;
    nixos) target="$flake#$(hostname -s)" ;;
    linux)
      profile=devops
      [[ -r "$HOME/.dotfiles-profile" ]] && profile=$(<"$HOME/.dotfiles-profile")
      arch=$(uname -m)
      [[ $arch == arm64 ]] && arch=aarch64
      target="$flake#$(whoami)-$profile-$arch-linux"
      ;;
  esac
  print -r -- "upd${_upd_mode:+ $_upd_mode} — $_upd_system — $target"
  if [[ $_upd_mode != install ]]; then
    if [[ $_upd_system == darwin ]] && (( $+commands[determinate-nixd] )); then
      _upd_step 'Nix daemon' sudo determinate-nixd upgrade || return
    fi
    _upd_step 'Nix dependencies' nix flake update --no-warn-dirty --flake "$flake" || return
  fi
  _upd_step 'Validate configuration' nix flake check --no-build --all-systems \
    --no-warn-dirty --no-update-lock-file "$flake" || return
  case $_upd_system in
    darwin)
      _upd_step 'Apply configuration' sudo darwin-rebuild switch --option warn-dirty false \
        --no-update-lock-file --flake "$target" || return
      ;;
    nixos)
      _upd_step 'Apply configuration' sudo nixos-rebuild switch --no-update-lock-file --flake "$target" || return
      ;;
    linux)
      _upd_step 'Apply configuration' home-manager switch --no-update-lock-file --flake "$target" -b hm-backup || return
      ;;
  esac
  if [[ $_upd_mode != install ]]; then
    if [[ $_upd_system == darwin ]]; then
      _upd_step 'Homebrew metadata' brew update || return
      _upd_step 'Homebrew formulae' brew upgrade --formula || return
      _upd_step 'Homebrew casks (--greedy)' _upd_casks || return
      _upd_step 'Command Line Tools' _upd_clt || return
      if (( $+commands[mas] )); then
        _upd_step 'App Store' mas upgrade || return
      fi
    elif [[ $_upd_system == linux ]] && (( $+commands[apt-get] )); then
      _upd_step 'APT metadata' sudo apt-get update || return
      _upd_step 'APT packages' sudo apt-get upgrade -y || return
    fi
    _upd_step 'Claude Code' claude update || return
    _upd_step 'MCP tools (npm/uv, timing on macOS)' _upd_mcp || return
    _upd_step 'Neovim plugins, parsers, and Mason tools' _upd_nvim || return
    _upd_step 'zinit plugins' _upd_zinit || return
  fi
  print 'Done. Previous Nix generations have been kept.'
}

if [[ $ZSH_EVAL_CONTEXT == toplevel ]]; then
  _upd_main "$@"
fi
