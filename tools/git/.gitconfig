[user]
	name = Timofey Kondrashin
	email = tkondrashin@icloud.com
	signingKey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDsx73RvU7CaBdKkAcRXcLdIG/APXzi5l4sxY+5J57EV cosmdandy@macbook-cosmdandy
[core]
	editor = nvim
	autocrlf = input
	hooksPath = ~/.git-hooks
	excludesfile = ~/.gitignore_global
[transfer]
	fsckObjects = true
[fetch]
	fsckObjects = true
[receive]
	fsckObjects = true
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.allowed_signers
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	# Родитель хранит сабмодуль как gitlink — 20 байт хеша, и по умолчанию push
	# не проверяет, достижим ли этот объект на remote сабмодуля. Запушенный
	# указатель на незапушенный коммит ломает клоны: fetch падает с
	# "upload-pack: not our ref". Случалось трижды (35f30a2, 155b0c0, abe813b).
	# on-demand сам пушит сабмодуль перед родителем; при detached HEAD пушить
	# ему некуда — тогда он не молчит, а падает, как check.
	recurseSubmodules = on-demand
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[includeIf "gitdir:/workspaces/"]
	path = ~/.gitconfig-work
[includeIf "gitdir:~/Work/"]
	path = ~/.gitconfig-work
