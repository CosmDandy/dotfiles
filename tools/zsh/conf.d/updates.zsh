# Общая машинерия обновления — используется и updm (мак), и updl (контейнер).

# Один шаг прогона обновления: печатает метку до запуска, а при падении — номер,
# название и сколько шагов уже применилось. Раньше updm был цепочкой из 11 команд
# на &&: отказ где-то на середине не говорил ни где встало, ни дошло ли до switch,
# ни надо ли откатывать поколение. Общий для updm и updl.
_upd_step() {
  local label=$1; shift
  (( _upd_i++ ))
  print -P "%F{blue}▸ [$_upd_i] $label%f"
  # Код берём сразу после команды, а не в ветке `if ! cmd`: там $? — уже результат
  # отрицания, то есть всегда 0, и шаг рапортовал бы об успехе при падении.
  "$@"
  local code=$?
  if (( code != 0 )); then
    print -P "%F{red}✗ шаг $_upd_i «$label» упал (код $code).%f" >&2
    print -P "%F{yellow}  Шаги 1..$((_upd_i - 1)) уже применены — прогон не откатывается сам.%f" >&2
    return $code
  fi
}

_upd_zinit() { zinit self-update && zinit update && zinit cclear }
