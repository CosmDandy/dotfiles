  "model": "opus[1m]",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/precompact-snapshot.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/pretooluse-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/pretooluse-opsctx.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/posttooluse-lint.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/posttooluse-bashhint.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/sessionstart-state.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/sessionend-fold.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/sound.sh Blow",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/sound.sh Basso",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/posttooluse-bashhint.sh",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.dotfiles/tools/claude/hooks/sound.sh Basso",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 15
  },
  "outputStyle": "default",
  "language": "Russian",
  "feedbackSurveyRate": 0,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": false,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
