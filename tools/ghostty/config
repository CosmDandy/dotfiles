font-size = 16
theme = light:iTerm2 Solarized Light,dark:iTerm2 Solarized Dark
cursor-color = 2aa198

fullscreen = true

mouse-hide-while-typing = true
clipboard-paste-protection = true
# OSC 52: приложения (nvim/tmux/Claude Code) читают буфер без запроса-диалога.
clipboard-read = allow

# Заголовок вкладки отдаём скрипту tab-title.zsh (иконки VM/контейнера).
# Список мержится с дефолтом, а не заменяет его: cursor/path остаются.
# ssh-* по умолчанию выключены. ssh-terminfo при первом заходе на хост заливает
# туда xterm-ghostty через infocmp|tic и запоминает его (ghostty +ssh-cache) —
# без этого ncurses на серверах не знает такого типа терминала. ssh-env —
# фолбэк на xterm-256color для хостов, где tic недоступен.
shell-integration-features = no-title,ssh-env,ssh-terminfo

# keyboard-first: нейтрализуем мышь, но оставляем живой скролл
# (Claude Code/nvim/TUI листаются колесом через mouse-reporting)
# выделение мышью ничего не копирует
copy-on-select = false
# клик в промпте не двигает курсор
cursor-click-to-move = false

macos-option-as-alt = true
desktop-notifications = true
# Уведомления Ghostty на macOS не работают — проверено 2026-09-02 дважды: OSC 777
# и OSC 9 через tmux-passthrough (allow-passthrough on) и они же в Quick Terminal,
# вне tmux, с выданным разрешением в системных настройках. Ни одно не показалось.
# Поэтому desktop-notifications ниже ничего не меняет, а preferredNotifChannel в
# Claude Code остаётся terminal_bell: звонок доходит и из контейнера, а баннеры на
# маке рисует хук через osascript.
# Выключено намеренно. Дефолтный notify-on-command-finish-action = bell,no-notify,
# то есть Ghostty на каждую команду дольше порога звонил (а с bell-features audio
# это стало Submarine) и при этом НЕ показывал уведомление. Показать он его и не
# может: уведомления Ghostty на macOS не работают (ghostty-org/ghostty#10151).
# Сигналы о своих событиях даёт сам Claude через hooks/sound.sh, дубль не нужен.
notify-on-command-finish = never
notify-on-command-finish-after = 10s
# audio + путь: озвучиваем BEL здесь, на хосте, а не в tmux — тогда сигнал
# из dev-контейнера (где нет afplay) слышен так же, как локальный.
# Остаётся только звук. Убрано: system (системный бип поверх своего звука), border
# (рамка вокруг панели), attention (подпрыгивание иконки в доке — док скрыт, сигнал
# уходил в никуда) и title (эмодзи 🔔 в заголовке; там уже стоят счётчики сессий,
# и они говорят не «здесь звонили», а сколько кого ждёт).
bell-features = audio
# Тот же звук, что у баннера Claude: локальная сессия зовёт баннером, контейнерная
# — звонком через ssh и tmux, и различать их на слух не нужно, адрес всё равно
# в заголовке вкладки.
bell-audio-path = /System/Library/Sounds/Blow.aiff
bell-audio-volume = 0.4
keybind = shift+enter=text:\x1b\r

# Quick Terminal (Quake-стиль): выезжает сверху по глобальному Option+F5, поверх любого приложения.
quick-terminal-position = top
keybind = global:alt+f5=toggle_quick_terminal

font-family = "JetBrainsMono Nerd Font"

minimum-contrast = 1.1
alpha-blending = linear-corrected
# window-padding-color = extend

# Отступы убраны совсем: дефолтные 2px оставляют у стекла полоску фона, 0 — впритык.
# balance — при fullscreen ширина не делится на ячейки нацело, и остаток без него
# уходит одной полосой вправо/вниз; с ним разносится симметрично по обеим сторонам.
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

# blueprint, chalkboard, microchip, gclass, holographic, paper, retro, xray
macos-icon = xray

unfocused-split-opacity = 0.8

split-preserve-zoom = navigation

keybind = super+alt+y=goto_split:left
keybind = super+alt+h=goto_split:down
keybind = super+alt+a=goto_split:up
keybind = super+alt+e=goto_split:right
